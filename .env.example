ANTHROPIC_API_KEY=sk-ant-...

# Models
ORCHESTRATOR_MODEL=claude-haiku-4-5-20251001
SEARCH_MODEL=claude-haiku-4-5-20251001
MATCHER_MODEL=claude-haiku-4-5-20251001
SKILLS_GAP_MODEL=claude-haiku-4-5-20251001

# Browser
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=800

# Scraping
MAX_JOBS_PER_SEARCH=20
MAX_TOTAL_JOBS=25
JOB_DETAIL_DELAY_MS=4000
MATCHER_BATCH_SIZE=15
# Description chars shown to the matcher (upstream fetch caps at 8000)
MATCHER_DESCRIPTION_CHARS=7000

# Pipeline
MAX_REFINEMENT_ITERATIONS=1
ORCHESTRATOR_TIMEOUT=600.0

# Search filters (URL-level)
# Locations to search (comma-separated) — one scrape_jobs call per entry
SEARCH_LOCATIONS=Remote
# Recency filter (f_TPR): past_day | past_week | past_month | any_time
SEARCH_DATE_POSTED=past_week
# Work mode(s) applied to f_WT: remote | hybrid | on-site (comma-separated).
# Leave empty to collect all modes and let the matcher filter instead.
SEARCH_WORK_MODES=remote
# Job type(s) applied to f_JT (comma-separated):
# full-time | part-time | contract | temporary | internship | volunteer.
# Leave empty to collect all types and let the matcher filter instead.
SEARCH_JOB_TYPES=contract,temporary,part-time
